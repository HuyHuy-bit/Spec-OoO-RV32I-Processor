        <mxCell id="e75" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=1;rounded=0;strokeColor=#ea580c;strokeWidth=1.6;dashed=1;dashPattern=7 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1004" y="624" as="sourcePoint"/><mxPoint x="1044" y="624" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="t76" value="planned" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11.5;fontColor=#374151;fontStyle=2;rotation=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="1054" y="618" width="51" height="14" as="geometry"/></mxCell>
        <mxCell id="t77" value="Loads, stores, CSR ops and fences execute one at a time when they reach the ROB head; no load/store queue yet." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12.5;fontColor=#1f2937;fontStyle=0;rotation=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="466" y="652" width="770" height="14" as="geometry"/></mxCell>
        <mxCell id="t78" value="A cacheable store retires only after admission; the planned producer fills its D$ line first and traps on a refill error." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12.5;fontColor=#1f2937;fontStyle=0;rotation=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="466" y="674" width="770" height="14" as="geometry"/></mxCell>
        <mxCell id="t79" value="FENCE.I: once it retires, fetch holds, the D$ writes back dirty lines, the I$ invalidates, and fetch restarts at PC+4." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12.5;fontColor=#1f2937;fontStyle=0;rotation=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="466" y="696" width="770" height="14" as="geometry"/></mxCell>
        <mxCell id="t80" value="Static not-taken prediction; only port 0 resolves branches. Module-level detail is in docs/architecture.md." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12.5;fontColor=#1f2937;fontStyle=0;rotation=0;spacing=0;" vertex="1" parent="1"><mxGeometry x="466" y="718" width="770" height="14" as="geometry"/></mxCell>
