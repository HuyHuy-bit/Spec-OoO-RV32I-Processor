        <mxCell id="b13" value="&lt;b style='font-size:14px'&gt;Reorder buffer&lt;/b&gt;&lt;br&gt;32 entries, ID = 5-bit slot + 8-bit generation&lt;br&gt;in-order retire 2/cycle, frees old physical regs&lt;br&gt;faults and traps are taken at the head" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#6d28d9;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="650" y="440" width="590" height="100" as="geometry"/></mxCell>
