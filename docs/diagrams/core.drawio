        <mxCell id="b1" value="&lt;b style='font-size:14px'&gt;Instruction port&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#111827;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="230" y="18" width="170" height="38" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b style='font-size:14px'&gt;Next PC&lt;/b&gt;&lt;br&gt;redirect priority:&lt;br&gt;flush &amp;gt; system &amp;gt; branch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b style='font-size:14px'&gt;L1 I$&lt;/b&gt;&lt;br&gt;1 KiB, 2-way, 32 B lines&lt;br&gt;read-only, blocking" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="230" y="90" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b style='font-size:14px'&gt;Fetch line buffer&lt;/b&gt;&lt;br&gt;one 32 B line&lt;br&gt;2 instr/cycle, predict PC+4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="440" y="90" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="b5" value="&lt;b style='font-size:14px'&gt;Decode ×2&lt;/b&gt;&lt;br&gt;+ fetch / illegal&lt;br&gt;fault decode" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="650" y="90" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="b6" value="&lt;b style='font-size:14px'&gt;Rename ×2&lt;/b&gt;&lt;br&gt;map table + free list&lt;br&gt;64 physical regs, p0 = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="860" y="90" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="b7" value="&lt;b style='font-size:14px'&gt;Branch checkpoints&lt;/b&gt;&lt;br&gt;8 map-table snapshots" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1070" y="90" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="b8" value="&lt;b style='font-size:14px'&gt;Head dispatch&lt;/b&gt;&lt;br&gt;holds one CSR / MRET /&lt;br&gt;WFI / load / store / fence&lt;br&gt;op, skips the IQ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="440" y="240" width="170" height="100" as="geometry"/></mxCell>
        <mxCell id="b9" value="&lt;b style='font-size:14px'&gt;Issue queue&lt;/b&gt;&lt;br&gt;16 entries&lt;br&gt;wakeup + select ×2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="650" y="240" width="170" height="100" as="geometry"/></mxCell>
        <mxCell id="b10" value="&lt;b style='font-size:14px'&gt;Physical register file&lt;/b&gt;&lt;br&gt;64 × 32 bit&lt;br&gt;4 read, 2 write ports" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=1.6;fontFamily=Arial;fontSize=12;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="860" y="240" width="170" height="100" as="geometry"/></mxCell>
